{
  "name": "@web-games/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Online rooms on Durable Objects. Deployed on its own (engames-realtime); the portal only signs tickets for it.",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler types && wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler types && wrangler deploy"
  },
  "dependencies": {
    "@web-games/core": "workspace:*",
    "@web-games/games": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
