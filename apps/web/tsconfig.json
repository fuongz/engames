{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "@types/node"],
    // Mirrors `imports` in package.json. `tsc` reads ONLY this; every runtime
    // reads only that. Two declarations, no third.
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  // worker-configuration.d.ts is generated by `wrangler types` (run by `build`).
  // It is in INCLUDE, not `types`: a missing file in include fails loudly, while a
  // miss in `types` silently leaves `env` untyped.
  "include": ["src", "vite.config.ts", "drizzle.config.ts", "worker-configuration.d.ts"]
}
