{
  "name": "@web-games/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//imports": "One alias, declared HERE and mirrored in tsconfig.json `paths`. Nowhere else — `#` is a Node subpath prefix that vite, rolldown and `bun run` all resolve natively, so a vite `resolve.alias` would be a third place to forget.",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "//build": "`wrangler types` FIRST: it writes worker-configuration.d.ts, which tsconfig include-lists. Wiring it into build keeps `bun run gate` green on a fresh clone.",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply prod-engames --local",
    "db:migrate:remote": "wrangler d1 migrations apply prod-engames --remote",
    "test": "bun test src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@web-games/games": "workspace:*",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16",
    "wrangler": "^4.151.3"
  }
}
