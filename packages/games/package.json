{
  "name": "@web-games/games",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "//": "Framework-free canvas games. Consumed as TypeScript source by the web app's Vite build (import.meta.glob discovers games), so there is no build step here.",
  "exports": {
    ".": "./src/registry.ts",
    "./i18n": "./src/core/i18n.ts",
    "./online": "./src/online/index.ts",
    "./online/client": "./src/online/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "art": "node tools/render-art.mjs"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/handjet": "^5.3.1"
  }
}
