{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
    // Rule exceptions go HERE, each with the reason and the file that forced it.
    // An exception with no stated reason becomes permanent, because nobody can
    // tell whether it is still needed.
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },

  // Formatter ON, assists OFF. `source/organizeImports` sorts alphabetically,
  // which destroys import GROUPING — external packages, then server-only, then
  // components, then lib. Formatting is mechanical and has one right answer;
  // import order is information.
  "assist": {
    "enabled": false
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  // THE lint/format config for the whole repo. Exclusions belong HERE, never in a
  // nested per-workspace config: a nested `files.includes` REPLACES this list
  // rather than merging with it, so one app declaring its own `includes` silently
  // drops every exclusion below and lints minified build output instead.
  //
  // Keep build-output globs in step with what your apps actually emit. An app that
  // builds to a directory not listed here will have its minified bundle linted —
  // measured elsewhere at 14,700 errors from a single unlisted output folder.
  "files": {
    "includes": [
      "**/*",
      "!**/node_modules",
      "!**/*.d.ts",
      // build output
      "!**/dist",
      "!**/.output",
      // framework / tooling caches
      "!**/.vite",
      "!**/.tanstack",
      "!**/.wrangler",
      // generated by the route generator — never hand-edited, never linted
      "!**/routeTree.gen.ts"
    ]
  },

  // `components/ui/**` is registry CLI territory: the next `shadcn add` overwrites
  // whatever is in there, so an inline `biome-ignore` in a registry file is wiped
  // and the finding comes back. Declare those exceptions HERE instead, naming the
  // rule and tracing the reason to the emitting file.
  "overrides": [
    {
      "includes": ["**/components/ui/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off"
          },
          // shadcn emits `import * as React from "react"` used only for types
          // (card, dialog, input, toggle-group); regeneration would undo a fix.
          "style": {
            "useImportType": "off"
          },
          // input-group.tsx (pulled in by command) puts role="group" and a
          // click-to-focus handler on a div; the focus target is the inner input,
          // which keeps keyboard access. Regeneration would undo an edit.
          "a11y": {
            "useSemanticElements": "off",
            "useKeyWithClickEvents": "off"
          }
        }
      }
    }
  ]
}
